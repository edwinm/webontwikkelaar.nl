    <script defer data-domain="webontwikkelaar.nl" src="https://data.bitstorm.org/js/script.js"></script>
    <script>
        // Global, so the header editor (assets/edit.js) can use them
        let seed = {{ seed }};
        const settings = {{ settings | json }};

        (function () {
            document.addEventListener("keypress", function ({charCode, ctrlKey, shiftKey}) {
                if (charCode === 5 && ctrlKey && shiftKey) { // CTRL-SHIFT-E
                    var script = document.createElement('script');
                    script.src = '/assets/edit.js';
                    document.head.appendChild(script);
                }
            })

            var buildDate = "{{ buildDate }}";
            addEventListener("focus", function () {
                var now = new Date();
                if (now.toISOString().slice(0, 10) <= buildDate) {
                    return;
                }
                if (now.getUTCHours() * 60 + now.getUTCMinutes() < 4 * 60 + 23) {
                    return;
                }
                try {
                    if (Date.now() - sessionStorage.reloadCheck < 600000) {
                        return;
                    }
                    sessionStorage.reloadCheck = Date.now();
                } catch (e) {}
                location.reload();
            });
        })();
        (function () {
            let folds = {};
            try {
                folds = JSON.parse(localStorage.folds || "{}");
            } catch (e) {}

            const isFold = (node) => node.className === "fold" || node.id === "more-blogs";

            // Restore each fold as the parser inserts it, before the first paint
            const observer = new MutationObserver(function (records) {
                for (const {addedNodes} of records) {
                    for (const node of addedNodes) {
                        if (isFold(node) && node.name in folds) {
                            node.checked = folds[node.name];
                        }
                    }
                }
            });
            observer.observe(document, {childList: true, subtree: true});
            document.addEventListener("DOMContentLoaded", function () {
                observer.disconnect();
            });

            document.addEventListener("change", function ({target}) {
                if (isFold(target)) {
                    folds[target.name] = target.checked;
                    try {
                        localStorage.folds = JSON.stringify(folds);
                    } catch (e) {}
                }
            });

            document.addEventListener("click", function ({target}) {
                const link = target.closest?.(".menu a");
                const section = link && document.querySelector(link.hash);
                const fold = section?.querySelector(".fold:checked");
                if (fold) {
                    const animated = [section, ...section.querySelectorAll(":scope > h2 ~ *")];
                    animated.forEach(el => el.style.transition = "none");
                    fold.click();
                    section.offsetHeight;
                    animated.forEach(el => el.style.transition = "");
                }
            });
        })();
        (function () {
            // Dots in the header background swell slightly around the mouse pointer
            if (!matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
                return;
            }

            const RADIUS = 140; // in svg units
            const GROW = 0.4;
            let svg, dots = [], active = new Set(), pointer = null, frame = 0;

            // The editor replaces the svg, so look it up again when it's gone
            function getSvg() {
                if (!svg || !svg.isConnected) {
                    svg = document.querySelector("svg.header-background");
                    dots = svg ? [...svg.querySelectorAll("circle")].map(el => ({
                        el,
                        x: el.cx.baseVal.value,
                        y: el.cy.baseVal.value
                    })) : [];
                    active.clear();
                }
                return svg;
            }

            function update() {
                frame = 0;
                if (!getSvg()) {
                    return;
                }
                const next = new Set();
                if (pointer) {
                    const p = new DOMPoint(pointer.x, pointer.y).matrixTransform(svg.getScreenCTM().inverse());
                    for (const dot of dots) {
                        const d = Math.hypot(dot.x - p.x, dot.y - p.y);
                        if (d < RADIUS) {
                            const t = 1 - d / RADIUS;
                            dot.el.style.scale = 1 + GROW * t * t;
                            next.add(dot);
                        }
                    }
                }
                for (const dot of active) {
                    if (!next.has(dot)) {
                        dot.el.style.scale = "";
                    }
                }
                active = next;
            }

            function schedule(value) {
                pointer = value;
                frame ||= requestAnimationFrame(update);
            }

            document.addEventListener("pointermove", function ({target, clientX, clientY}) {
                schedule(target.closest?.("header") ? {x: clientX, y: clientY} : null);
            });
            document.documentElement.addEventListener("pointerleave", function () {
                schedule(null);
            });
        })();
    </script>
</head>
