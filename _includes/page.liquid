---
settings:
    num: 12
    minsize: 5
    maxsize: 30
    border: 3
    lightness: 73
    chroma: 24
    deviation: 10
---

<!doctype html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    {% if title %}
    <title>{{ title }} - webontwikkelaar.nl</title>
    {% else %}
    <title>webontwikkelaar.nl</title>
    {% endif %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ i18n[lang].description }}">
    <meta property="og:image" content="https://webontwikkelaar.nl/assets/{{ i18n[lang].meta_img }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {% if title %}
    <meta property="og:title" content="{{ title }}">
    <meta property="og:site_name" content="webontwikkelaar.nl">
    {% endif %}
    <meta name="theme-color" content="#e8f2f6">
    <meta name="dcterms.modified" content="{{ feeds.lastUpdated | isoDate }}">
    <link rel="stylesheet" href="/assets/style.css">
    <link rel="icon" href="/favicon.ico" sizes="48x48"/>
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {% if page.url == "/" or page.url == "/en/" %}
    <link rel="alternate" hreflang="en" href="https://webontwikkelaar.nl/en" />
    <link rel="alternate" hreflang="nl" href="https://webontwikkelaar.nl/" />
    {% endif %}

    <style>
        @font-face {
            font-family: Moderustic;
            src: url("/assets/fonts/Moderustic/Moderustic-VariableFont_wght.woff2") format("woff2-variations");
            font-weight: 100 900;
            font-style: normal;
            font-display: swap;
        }

        body {
            font-family: Moderustic, sans-serif;
        }
    </style>
    <script defer data-domain="webontwikkelaar.nl" src="https://data.bitstorm.org/js/script.js"></script>
    <script>
        document.addEventListener("keypress", function ({charCode, ctrlKey, shiftKey}) {
            if (charCode === 5 && ctrlKey && shiftKey) { // CTRL-SHIFT-E
                var script = document.createElement('script');
                script.src = '/assets/edit.js';
                document.head.appendChild(script);
            }
        })
        let seed = {{ seed }};
        const settings = {{ settings | json }};
    </script>
</head>
<body>

{% circles 'header-background', 1600, 320, settings %}

<ul class="lang-switch lang-{{ lang }}">
    <li class="lang nl">{% if lang == 'nl' %}NL{% else %}<a href="/">NL</a>{% endif %}</li>
    <li class="lang en">{% if lang == 'en' %}EN{% else %}<a href="/en">EN</a>{% endif %}</li>
</ul>

{{ content }}

<footer>
    <a href="{{ i18n[lang].privacy_url }}">{{ i18n[lang].privacy }}</a>
    •
    <a href="{{ i18n[lang].about_url }}">{{ i18n[lang].about }}</a>
</footer>

</body>
</html>