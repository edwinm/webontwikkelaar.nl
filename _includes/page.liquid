---
settings:
    num: 12
    minsize: 5
    maxsize: 30
    border: 3
    lightness: 73
    chroma: 24
---

<!doctype html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    {% if title %}
    <title>{{ title }} - webontwikkelaar.nl</title>
    {% else %}
    <title>webontwikkelaar.nl</title>
    {% endif %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Blijf elke dag scherp als webontwikkelaar">
    <meta property="og:image" content="https://webontwikkelaar.nl/assets/share.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {% if title %}
    <meta property="og:title" content="{{ title }}">
    <meta property="og:site_name" content="webontwikkelaar.nl">
    {% endif %}
    <meta name="theme-color" content="#A9CEEB">
    <meta name="dcterms.modified" content="{{ feeds.lastUpdated }}">
    <link rel="stylesheet" href="/assets/style.css">
    <link rel="icon" href="/favicon.ico" sizes="48x48"/>
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script defer data-domain="webontwikkelaar.nl" src="https://data.bitstorm.org/js/script.js"></script>
    <script>
        document.addEventListener("keypress", function ({charCode, ctrlKey, shiftKey}) {
            if (charCode === 5 && ctrlKey && shiftKey) { // CTRL-SHIFT-E
                var script = document.createElement('script');
                script.src = '/assets/edit.js';
                document.head.appendChild(script);
            }
        })
        let seed = {{ seed }};
        const settings = {{ settings | json }};
    </script>
</head>
<body>

{% circles 'header-background', 1600, 320, settings %}

{{ content }}

<footer>
    <a href="/privacy.html">privacyverklaring</a>
    •
    <a href="/over.html">over deze site</a>
</footer>

</body>
</html>