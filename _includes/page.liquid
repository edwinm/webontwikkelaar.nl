<!doctype html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>webontwikkelaar.nl</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Verzameld nieuws voor webontwikkelaars">
    <link rel="stylesheet" href="/assets/style.css">
    <link rel="icon" href="/favicon.ico" sizes="48x48"/>
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script defer data-domain="webontwikkelaar.nl" src="https://data.bitstorm.org/js/script.js"></script>
    <script>
        document.addEventListener("keypress", function ({charCode, ctrlKey, shiftKey}) {
            if (charCode === 5 && ctrlKey && shiftKey) {
                var script = document.createElement('script');
                script.src = '/assets/edit.js';
                document.head.appendChild(script);
            }
        })
        // document.addEventListener("DOMContentLoaded", function () {
        //     var script = document.createElement('script');
        //     script.src = '/assets/edit.js';
        //     document.head.appendChild(script);
        // });
    </script>
</head>
