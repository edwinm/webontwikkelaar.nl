{
  "$description": "Fonts converted by Woffle; their @font-face rules are in fonts.css.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "bigshot-one": {
        "$value": [
          "Bigshot One",
          "Bigshot One Fallback Roboto",
          "Bigshot One Fallback",
          "sans-serif"
        ],
        "$extensions": {
          "org.bitstorm.woffle": {
            "styles": [
              {
                "name": "Regular",
                "weight": 400,
                "style": "normal",
                "file": "Bigshot_One/BigshotOne-Regular.woff2"
              }
            ]
          }
        }
      },
      "moderustic": {
        "$value": [
          "Moderustic",
          "Moderustic Fallback Roboto",
          "Moderustic Fallback",
          "sans-serif"
        ],
        "$extensions": {
          "org.bitstorm.woffle": {
            "styles": [
              {
                "name": "Regular",
                "weight": [
                  300,
                  800
                ],
                "style": "normal",
                "file": "Moderustic/Moderustic-VariableFont_wght.woff2"
              }
            ]
          }
        }
      },
      "recursive": {
        "$value": [
          "Recursive",
          "Recursive Fallback Roboto",
          "Recursive Fallback",
          "sans-serif"
        ],
        "$extensions": {
          "org.bitstorm.woffle": {
            "styles": [
              {
                "name": "Sans Linear Light",
                "weight": [
                  300,
                  1000
                ],
                "style": "normal",
                "file": "Recursive/Recursive-VariableFont_CASL,CRSV,MONO,slnt,wght.woff2",
                "subset": "Recursive/Recursive-VariableFont_CASL,CRSV,MONO,slnt,wght-subset.woff2",
                "unicodeRange": "U+20-7E, U+A0, U+A7, U+AB, U+B2-B3, U+BB, U+C0-C2, U+C4-CB, U+CD-CF, U+D3-D4, U+D6, U+D8-DC, U+E0-E2, U+E4-EB, U+ED-EF, U+F3-F4, U+F6, U+F8-FC, U+FF, U+152-153, U+178, U+301, U+2010, U+2013-2014, U+2018-2019, U+201C-201D, U+2020-2022, U+2026, U+2030, U+2032-2033, U+2212"
              }
            ]
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "bigshot-one": {
        "regular": {
          "$value": 400
        }
      },
      "moderustic": {
        "light": {
          "$value": 300
        },
        "regular": {
          "$value": 400
        },
        "medium": {
          "$value": 500
        },
        "semi-bold": {
          "$value": 600
        },
        "bold": {
          "$value": 700
        },
        "extra-bold": {
          "$value": 800
        }
      },
      "recursive": {
        "light": {
          "$value": 300
        },
        "1000": {
          "$value": 1000
        }
      }
    }
  }
}
