---
layout: page
permalink: /index.html
lang: nl
---

<header>
    {% raster 'header-background', settings %}
    <h1 class="title" translate="no">webontwikkelaar<span class="title-tld">.nl</span></h1>
    <p class="tagline">Dagelijks frontend nieuws</p>
    <h2 class="update">{{ feeds.lastUpdated | dutchLongDate }}</h2>
    <nav class="menu" aria-label="Rubrieken">
        <ul>
            {%- if feeds.conferences.length > 0 %}
                <li><a class="menu-conf" href="#conferenties">
                    <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    Conferenties</a></li>
            {%- endif %}
            {%- if feeds.posts.length > 0 %}
                <li><a class="menu-blogs" href="#blogs">
                    <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
                    Blogs</a></li>
            {%- endif %}
            {%- if feeds.videos.length > 0 %}
                <li><a class="menu-videos" href="#videos">
                    <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4z"/></svg>
                    Video’s</a></li>
            {%- endif %}
            {%- if feeds.podcasts.length > 0 %}
                <li><a class="menu-podcasts" href="#podcasts">
                    <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></svg>
                    Podcasts</a></li>
            {%- endif %}
        </ul>
    </nav>
</header>

<main>

    {% if feeds.conferences.length > 0 %}

        <style>
            {%- for city in feeds.cities -%}

            .conferences:has(.city.city-{{ city.slug }}:hover) .conf-row.city-{{ city.slug }} > td {
                color: var(--background);
                background: var(--city);
            }

            .conferences:has(.conf-row.city-{{ city.slug }}:hover) .city.city-{{ city.slug }} {
                outline-offset: 10px;
            }

            {%- endfor -%}
        </style>

        <section class="container conf-container" id="conferenties">
            <h2><label><input class="fold" type="checkbox" name="conferences">Conferenties en bijeenkomsten</label></h2>

            <div class="conferences">
                <table class="conf-table">
                    {%- for conference in feeds.conferences -%}
                        <tr class="conf-row city-{{ conference.slug }}">
                            <td><a class="conf-link"
                                   href="{{ conference.url }}">{{ conference.start_date | dateRange: conference.end_date }}</a>
                            </td>
                            <td>{{ conference.city }}</td>
                            <td>
                                <a class="conf-link" href="{{ conference.url }}">
                                    <p class="conf-meta item-feed-title">{{ conference.start_date | dateRange: conference.end_date }}
                                        • {{ conference.city }}</p>
                                    <h3 class="conf-title">{{ conference.title }}</h3>
                                </a>
                            </td>
                        </tr>
                    {%- endfor -%}
                </table>
                <div class="map">

                    {%- for city in feeds.cities -%}
                        <div class="city city-{{ city.slug }}"
                             style="--lat: {{ city.latitude }}; --lon: {{ city.longitude }};"></div>

                    {%- endfor -%}

                    <picture>
                        <source media="(prefers-color-scheme: dark)" srcset="/assets/nl-vl-dark.svg"
                                type="image/svg+xml">
                        <img class="map-img" width="549" height="500" src="/assets/nl-vl.svg"
                             alt="Kaart van Nederland en Vlaanderen">
                    </picture>
                </div>
            </div>
        </section>
    {% endif %}

    {% if feeds.posts.length > 0 %}
        <section class="container blog-container box" id="blogs">
            <h2><label><input class="fold" type="checkbox" name="blogs">Blogs en nieuws</label></h2>

            <ul class="item-box">
                {%- for post in feeds.posts -%}
                    <li class="item" lang="{{ post.language | default: 'en' }}">
                        <a class="link item-link" href="{{ post.link }}">
                            <p class="item-feed-title">{{ post.feedTitle | escape_once }} <span class="grey">• <time
                                            itemprop="datePublished"
                                            datetime="{{ post.dateValue | ymdDate }}">{{ post.dateValue | dutchShortDate }}</time></span>
                            </p>
                            <h3 class="item-title">{{ post.title | escape_once }}</h3>
                        </a>
                    </li>
                {%- endfor -%}
            </ul>
            <p class="bottom-ui">
                <label class="bottom-ui-label">
                    <input id="more-blogs" type="checkbox" name="more-blogs">
                    <svg id="more-blogs-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down">
                        <path d="m6 9 6 6 6-6"/>
                    </svg>
                    <span id="more-blogs-text">toon meer</span>
                    <span id="less-blogs-text">toon minder</span>
                </label>
            </p>
        </section>
    {% endif %}

    {% if feeds.videos.length > 0 %}
        <section class="container video-container box" id="videos">
            <h2><label><input class="fold" type="checkbox" name="videos">Video’s</label></h2>

            <ul class="container box video-box">
                {%- for video in feeds.videos -%}
                    <li class="video">
                        <a class="link video-link" href="{{ video.link }}">
                            <img class="video-thumbnail" src="{{ video.thumbnail.url }}" alt="">
                            <p class="item-feed-title">{{ video.author | escape_once }} <span class="grey">• <time
                                            itemprop="datePublished"
                                            datetime="{{ video.dateValue | ymdDate }}">{{ video.dateValue | dutchShortDate }}</time></span>
                            </p>
                            <h3 class="video-title">{{ video.title | escape_once }}</h3>
                        </a>
                    </li>
                {%- endfor -%}
            </ul>
        </section>
    {% endif %}

    {% if feeds.podcasts.length > 0 %}
        <section class="container podcast-container box podcast-box" id="podcasts">
            <h2><label><input class="fold" type="checkbox" name="podcasts">Podcasts</label></h2>

            <ul class="podcast-list">
                {%- for podcast in feeds.podcasts -%}
                    <li class="podcast">
                        <article class="podcast-item">

                            <img class="podcast-thumbnail" src="{{ podcast.image | default: podcast.feedImage }}"
                                 alt="">

                            <div class="podcast-content">
                            <span class="item-feed-title podcast-creator">
                                {{ podcast.creator }}
                                • <span class="podcast-duration grey">{{ podcast.duration | duration }}</span>
                                • <span class="grey podcast-date"><time itemprop="datePublished"
                                                                        datetime="{{ podcast.dateValue | ymdDate }}">{{ podcast.dateValue | dutchShortDate }}</time></span>
                                <div class="podcast-icons">
                                {% if podcast.link != "" %}
                                    <a class="podcast-link" href="{{ podcast.link }}"><img
                                                class="podcast-logo podcast-link-logo" src="/assets/link.svg"
                                                alt="Link naar podcastpagina"/></a>
                                {% endif %}
                                    {% if podcast.feedItunesId %}
                                        <a class="podcast-apple"
                                           href="https://podcasts.apple.com/nl/podcast/id{{ podcast.feedItunesId }}"><img
                                                    class="podcast-logo podcast-apple-logo" src="/assets/apple.svg"
                                                    alt="Link naar Apple Podcasts"/></a>
                                    {% endif %}
                                </div>
                            </span>
                                <h3 class="podcast-title">{{ podcast.title | escape_once }}</h3>
                                <div class="podcast-controls">
                                    <audio class="podcast-audio" controls preload="none"
                                           src="{{ podcast.enclosureUrl }}"></audio>
                                </div>
                            </div>
                        </article>
                    </li>
                {%- endfor -%}
            </ul>
            <a class="podcast-attribution grey" href="https://podcastindex.org" target="_blank"
               rel="nofollow, noopener">
                Podcastgegevens geleverd door Podcast Index
            </a>
        </section>
    {% endif %}

</main>