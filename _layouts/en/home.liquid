---
layout: page
permalink: /en/index.html
lang: en
---

<header>
    <h1 class="title" translate="no">webontwikkelaar.nl</h1>
    <h2 class="update">{{ feeds.lastUpdated | englishLongDate }}</h2>
</header>

<main>

{% if feeds.posts.length > 0 %}
<h2>blogs and news</h2>

    <div class="container blog-container box">
        <ul class="item-box">
            {%- for post in feeds.posts -%}
                <li class="item" lang="{{ post.language | default: 'en' }}">
                    <a class="link item-link" href="{{ post.link }}">
                        <p class="item-feed-title">{{ post.feedTitle }} <span class="grey">• <time itemprop="datePublished" datetime="{{ post.dateValue | ymdDate }}">{{ post.dateValue | englishShortDate }}</time></span></p>
                        <h3 class="item-title">{{ post.title }}</h3>
                    </a>
                </li>
            {%- endfor -%}
        </ul>
        <p class="bottom-ui">
            <label class="bottom-ui-label">
                <input id="more-blogs" type="checkbox">
                <svg id="more-blogs-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
                <span id="more-blogs-text">show more</span>
                <span id="less-blogs-text">show less</span>
            </label>
        </p>
    </div>
{% endif %}

{% if feeds.videos.length > 0 %}
<h2>videos</h2>

<ul class="container box video-box">
        {%- for video in feeds.videos -%}
                <li class="video">
                        <a class="link video-link" href="{{ video.link }}">
                                <img class="video-thumbnail" src="{{ video.thumbnail.url }}" alt="">
                                <p class="item-feed-title">{{ video.author }} <span class="grey">• <time itemprop="datePublished" datetime="{{ video.dateValue | ymdDate }}">{{ video.dateValue | englishShortDate }}</time></span></p>
                                <h3 class="video-title">{{ video.title }}</h3>
                        </a>
                </li>
        {%- endfor -%}
</ul>
{% endif %}

{% if feeds.podcasts.length > 0 %}
    <h2>podcasts</h2>

    <div class="container box podcast-box">
        <ul class="podcast-list">
            {%- for podcast in feeds.podcasts -%}
                <li class="podcast">
                    <article class="podcast-item">

                        <img class="podcast-thumbnail" src="{{ podcast.image | default: podcast.feedImage }}" alt="">

                        <div class="podcast-content">
                            <span class="item-feed-title podcast-creator">
                                {{ podcast.creator }}
                                • <span class="podcast-duration grey">{{ podcast.duration | duration }}</span>
                                • <span class="grey podcast-date"><time itemprop="datePublished" datetime="{{ podcast.dateValue | ymdDate }}">{{ podcast.dateValue | englishShortDate }}</time></span>
                                <div class="podcast-icons">
                                {% if podcast.link != "" %}
                                    <a class="podcast-link" href="{{ podcast.link }}"><img class="podcast-logo podcast-link-logo" src="/assets/link.svg" alt="Link naar podcastpagina"/></a>
                                {% endif %}
                                {% if podcast.feedItunesId %}
                                    <a class="podcast-apple" href="https://podcasts.apple.com/nl/podcast/id{{ podcast.feedItunesId }}"><img class="podcast-logo podcast-apple-logo" src="/assets/apple.svg" alt="Link naar Apple Podcasts"/></a>
                                {% endif %}
                                </div>
                            </span>
                            <h3 class="podcast-title">{{ podcast.title }}</h3>
                            <div class="podcast-controls">
                                <audio class="podcast-audio" controls preload="none" src="{{ podcast.enclosureUrl }}"></audio>
                            </div>
                        </div>
                    </article>
                </li>
            {%- endfor -%}
        </ul>
        <a class="podcast-attribution grey" href="https://podcastindex.org" target="_blank" rel="nofollow, noopener">
            Podcast data provided by Podcast Index
        </a>
    </div>
{% endif %}

</main>